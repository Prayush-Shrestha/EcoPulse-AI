# ---------------------------------------------------------------------------
# EcoPulse AI - Docker Compose environment
# Copy this file to `.env` before starting the stack. Never commit `.env`.
# Use a URL-safe local password (letters, digits, underscores or hyphens).
# ---------------------------------------------------------------------------

POSTGRES_DB=ecopulse
POSTGRES_USER=ecopulse
POSTGRES_PASSWORD=ecopulse_local_dev
POSTGRES_PORT=5432

API_PORT=8000
FRONTEND_PORT=3000

ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
