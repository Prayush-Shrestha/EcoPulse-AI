# ---------------------------------------------------------------------------
# EcoPulse AI - local backend environment
# Copy this file to backend/.env. Never commit the resulting file.
# For Docker Compose, the root .env is used instead.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg://ecopulse:ecopulse_local_dev@localhost:5432/ecopulse
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=5

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Relative paths resolve from backend/. Saved Phase 4 artefacts live at the
# repository root, two levels above backend/.
ML_MODELS_DIR=../machine-learning/models

# Batch settings for scripts/import_processed_data.py.
IMPORT_BATCH_SIZE=5000
IMPORT_PROGRESS_EVERY=10
